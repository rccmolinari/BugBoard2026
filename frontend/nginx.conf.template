server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Le issue caricano immagini: il backend accetta richieste fino a 12MB.
    # nginx di default si ferma a 1MB -> senza questo gli upload darebbero 413.
    client_max_body_size 12m;

    # Reverse proxy: /api -> backend. Per il browser e' tutto same-origin,
    # quindi il CORS non scatta. ${BACKEND_URL} e' sostituito da envsubst
    # all'avvio del container (es. http://backend:8080 oppure http://IP:8080).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA in history mode (createWebHistory): ogni rotta sconosciuta
    # viene servita con index.html, ci pensa poi vue-router lato client.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
